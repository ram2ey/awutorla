{
  "name": "awu-torla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:hubtel && npm run test:workshop && npm run test:intake && npm run test:manual-payment && npm run test:schema && npm run test:sms && npm run test:database && npm run test:backend",
    "test:hubtel": "tsx scripts/run-tests.ts",
    "test:workshop": "tsx scripts/run-workshop-tests.ts",
    "test:intake": "tsx scripts/run-intake-tests.ts",
    "test:manual-payment": "tsx scripts/run-manual-payment-tests.ts",
    "test:schema": "tsx scripts/run-schema-tests.ts",
    "test:sms": "tsx scripts/run-manual-workflow-tests.ts",
    "test:database": "tsx scripts/run-database-tests.ts",
    "test:container": "node scripts/smoke-container.mjs",
    "test:backend": "node --test server/tests/backend.test.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "lucide-react": "^1.30.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
