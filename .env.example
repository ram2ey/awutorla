# Server-only runtime settings. No VITE_* keys or browser API credentials.
# Coolify: use the database's private connection URL and your HTTPS app domain.
DATABASE_URL=postgresql://atelier:replace-with-db-password@localhost:5432/atelier
APP_ORIGIN=http://localhost:5173
PORT=3000
UPLOAD_DIR=./uploads

# First deployment only: creates an admin if the staff table is empty.
# Set a unique password of at least 12 characters; remove it after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workshop Admin

# Only compose.yaml needs this. Use a long random hex/alphanumeric password.
POSTGRES_PASSWORD=
# Compose local testing only: NODE_ENV=development with APP_ORIGIN=http://localhost:3000
# Production containers require NODE_ENV=production and an HTTPS APP_ORIGIN.
